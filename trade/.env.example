# Polygon RPC (Alchemy/QuickNode recommended for production)
POLYGON_RPC=https://polygon-rpc.com

# Operator wallet private key (backend hot wallet that submits txs)
OPERATOR_PRIVATE_KEY=

# Deployed PalmVault contract address
VAULT_ADDRESS=

# Databento API key for FCPO palm oil prices (optional — mock price used if empty)
DATABENTO_API_KEY=

# USDT contract address (Polygon: 0xc2132D05D31c914a87C6611C10748AEb04B58e8F)
USDT_ADDRESS=0xc2132D05D31c914a87C6611C10748AEb04B58e8F

# Deployer private key (for contract deployment only, not needed at runtime)
DEPLOYER_PRIVATE_KEY=
