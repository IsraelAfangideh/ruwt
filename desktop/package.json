{
  "name": "ruwt-desktop",
  "private": true,
  "version": "0.2.0",
  "type": "module",
  "scripts": {
    "dev": "tauri dev",
    "build": "tauri build",
    "build:ui": "esbuild src/ui/main.ts --bundle --format=esm --outfile=ui/app.js --platform=browser --target=es2022 && cp ui/index.html ui/app.css ui/app.js launcher/ui/",
