# Ingestion key from ruwt.ai → Workspace settings → Create ingestion key
RUWT_INGESTION_KEY=ruwt_ing_...

# Optional override. Defaults to https://ruwt.ai/api/intelligence/events
# RUWT_INGESTION_URL=https://ruwt-ai.pages.dev/api/intelligence/events

# Local development against wrangler pages dev:
# RUWT_INGESTION_URL=http://127.0.0.1:8788/api/intelligence/events
