{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Ruwt",
  "version": "0.2.0",
  "identifier": "ai.ruwt.desktop",
  "build": {
    "frontendDist": "../ui",
    "beforeBuildCommand": "npm run build:ui",
    "beforeDevCommand": "npm run build:ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "Ruwt Desktop",
        "width": 980,
        "height": 720,
        "minWidth": 640,
        "minHeight": 520,
        "resizable": true,
        "center": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' data: asset: http://asset.localhost; style-src 'self' 'unsafe-inline'; script-src 'self' 'unsafe-inline'; connect-src 'self' ipc: http://ipc.localhost https://ipc.localhost https://ruwt.ai https://ruwt-ai.pages.dev",
      "capabilities": ["default"]
    }
  },
  "bundle": {
    "active": true,
    "targets": ["dmg", "nsis"],
    "category": "DeveloperTool",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "macOS": {
      "minimumSystemVersion": "11.0",
      "dmg": {
        "background": "src-tauri/dmg/background.png",
        "windowSize": { "width": 660, "height": 400 },
        "appPosition": { "x": 160, "y": 168 },
        "applicationFolderPosition": { "x": 500, "y": 168 }
      }
    },
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "displayLanguageSelector": false
      }
    }
  }
}
