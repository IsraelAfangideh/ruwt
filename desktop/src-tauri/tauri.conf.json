{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Ruwt Desktop",
  "version": "0.1.0",
  "identifier": "dev.ruwt.desktop",
  "build": { "frontendDist": "../ui" },
  "app": {
    "windows": [{ "title": "Ruwt Desktop", "width": 1120, "height": 760, "minWidth": 760, "minHeight": 560 }],
    "security": { "csp": "default-src 'self'; connect-src 'self' https:; img-src 'self' data:; style-src 'self' 'unsafe-inline'; script-src 'self'" }
  },
  "bundle": { "active": true, "targets": ["dmg", "msi"], "category": "DeveloperTool" }
}
