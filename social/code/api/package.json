{
    "name": "@ruwt/api",
    "version": "0.0.0",
    "scripts": {
        "start": "bun run src/index.ts",
        "dev": "bun --watch src/index.ts",
        "cli": "bun src/cli.ts",
        "db:generate": "drizzle-kit generate",
        "db:migrate": "bun run src/db/bootstrap.ts && bun run src/db/migrate.ts",
        "db:seed": "bun src/seed.ts"
    },
    "dependencies": {
        "@ruwt/shared": "*",
        "chalk": "^5.6.2",
        "drizzle-orm": "^0.36.0",
        "hono": "^4.0.0",
        "nodemailer": "^6.9.8",
        "ora": "^9.0.0",
        "postgres": "^3.4.0"
    },
    "devDependencies": {
        "@types/bun": "latest",
        "@types/node": "^24.10.1",
        "bun-types": "latest",
        "drizzle-kit": "^0.31.8"
    }
}
