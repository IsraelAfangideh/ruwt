{
  "name": "dev",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "prebuild": "node scripts/generate-og.mjs",
    "build": "tsc --noEmit && vite build",
    "typecheck": "tsc --noEmit",
    "preview": "vite preview",
    "lint": "eslint src --ext .ts,.tsx",
    "db:generate": "drizzle-kit generate",
    "db:push": "drizzle-kit push",
    "db:studio": "drizzle-kit studio",
    "db:seed": "npx tsx scripts/seed.ts",
    "db:seed-d1": "npx tsx scripts/seed-d1.ts",
    "db:d1:generate": "drizzle-kit generate --config=drizzle.config.d1.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:a11y": "vitest run --reporter=verbose src/test/a11y.test.tsx",
    "pages:dev": "wrangler pages dev dist --compatibility-date=2024-01-01",
    "postinstall": "patch-package"
  },
  "dependencies": {
    "@ai-sdk/anthropic": "^3.0.34",
    "@ai-sdk/openai": "^3.0.41",
    "@monaco-editor/react": "^4.7.0",
    "@react-navigation/native": "^7.0.0",
    "@react-navigation/native-stack": "^7.0.0",
    "@sentry/react": "^10.41.0",
    "@sentry/vite-plugin": "^4.9.1",
    "@stripe/stripe-js": "^8.7.0",
    "@supabase/ssr": "^0.8.0",
    "@supabase/supabase-js": "^2.93.3",
    "@webcontainer/api": "^1.6.1",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/xterm": "^6.0.0",
    "ai": "^6.0.66",
    "monaco-editor": "^0.55.1",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-hook-form": "^7.71.1",
    "react-native-safe-area-context": "^5.0.0",
    "react-native-web": "~0.19.13",
    "react-resizable-panels": "^4.7.1",
    "resvg-wasm": "^0.5.0",
    "stripe": "^20.3.0",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@types/node": "^20",
    "@types/react": "^18",
    "@types/react-dom": "^18",
    "@types/react-native-web": "^0.19.2",
    "@vitejs/plugin-react": "^4.3.4",
    "@vitest/coverage-istanbul": "^4.0.18",
    "@vitest/coverage-v8": "^4.0.18",
    "axe-core": "^4.11.1",
    "dotenv": "^17.2.4",
    "drizzle-kit": "^0.31.8",
    "drizzle-orm": "^0.45.1",
    "jsdom": "^28.1.0",
    "patch-package": "^8.0.1",
    "postgres": "^3.4.8",
    "sharp": "^0.34.5",
    "typescript": "^5",
    "vite": "^6.0.3",
    "vitest": "^4.0.18",
    "vitest-axe": "^0.1.0"
  }
}
