{
  "name": "mobile",
  "version": "1.0.0",
  "main": "index.js",
  "scripts": {
    "start": "expo start",
    "start:mock": "EXPO_PUBLIC_MOCK_MODE=true npx expo start --clear",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "build:ios": "EXPO_PUBLIC_MOCK_MODE=true npx expo run:ios",
    "build:android": "EXPO_PUBLIC_MOCK_MODE=true npx expo run:android",
    "test:e2e": "EXPO_PUBLIC_MOCK_MODE=true maestro test .maestro",
    "test:e2e:ios": "bash .maestro/scripts/test-e2e-ios.sh",
    "test:e2e:android": "bash .maestro/scripts/test-e2e-android.sh",
    "test:e2e:single": "EXPO_PUBLIC_MOCK_MODE=true maestro test",
    "test:e2e:watch": "maestro studio"
  },
  "dependencies": {
    "@react-navigation/native": "^7.1.24",
    "@react-navigation/native-stack": "^7.8.5",
    "@ruwt/shared": "*",
    "expo": "~54.0.25",
    "expo-clipboard": "^8.0.8",
    "expo-status-bar": "~3.0.8",
    "expo-updates": "~29.0.15",
    "react": "19.1.0",
    "react-native": "0.81.5",
    "react-native-safe-area-context": "~5.6.0",
    "react-native-screens": "~4.16.0",
    "react-native-svg": "15.12.1",
    "react-native-web": "^0.21.2"
  },
  "devDependencies": {
    "@types/react": "^19.2.7",
    "@types/react-native": "^0.73.0",
    "metro-config": "^0.83.3",
    "typescript": "^5.9.3"
  },
  "private": true
}
