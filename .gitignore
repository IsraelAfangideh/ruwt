# --------------------------------------------------------------------
# Dependencies
# --------------------------------------------------------------------
**/node_modules/

# --------------------------------------------------------------------
# Environment files (never commit secrets)
# --------------------------------------------------------------------
**/.env
**/.env.*
!**/.env.example
!**/.env.sample

# --------------------------------------------------------------------
# Local databases / binaries
# --------------------------------------------------------------------
**/*.db
**/*.sqlite
**/*.sqlite3
**/*.sqlite3-journal

# --------------------------------------------------------------------
# Maestro / test debug output (can be safely deleted)
# --------------------------------------------------------------------
**/.maestro-debug/
**/maestro-debug/
**/debug-*/
**/debug-*

# --------------------------------------------------------------------
# Build output
# --------------------------------------------------------------------
**/dist/

# Generated desktop launcher artifacts (built in CI)
/ai/public/downloads/*
!/ai/public/downloads/.gitkeep

# Tauri / Rust
desktop/src-tauri/target/
desktop/src-tauri/gen/
desktop/src-tauri/icons/android/
desktop/src-tauri/icons/ios/

# --------------------------------------------------------------------
# Local-only / editor / OS
# --------------------------------------------------------------------
.idea/
.idea/workspace.xml
.DS_Store
**/*.swp
**/*.swo
**/.zshrc

# Cursor stuff
/.cursor

# --------------------------------------------------------------------
# Hardhat / Foundry artifacts
**/artifacts/
**/cache/
**/typechain-types/

# Legacy / moved folders
# --------------------------------------------------------------------
# If you've moved the monorepo under social/code, keep the old root /code
# tree untracked to avoid accidental commits.
/code/